# URL of your backend server (see server/.env.example)
VITE_SERVER_URL=http://localhost:3001

# Google reCAPTCHA v2 SITE key (the public one — the secret key goes in server/.env).
# Get both at: https://www.google.com/recaptcha/admin/create
# (choose reCAPTCHA v2 > "I'm not a robot" Checkbox, and add both "localhost" and your
# deployed domain under Domains)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
