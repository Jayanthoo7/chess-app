PORT=3001

# Where your deployed frontend lives (used later for CORS/email links). For local dev this can stay as-is.
CLIENT_URL=http://localhost:5173

# Any long random string — used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) — get free keys at
# https://www.google.com/recaptcha/admin/create  (choose reCAPTCHA v2 > "I'm not a robot" Checkbox)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Gmail SMTP for sending OTP emails. Use a Gmail *App Password*, not your real Gmail password:
# 1. Turn on 2-Step Verification on your Google account
# 2. Go to https://myaccount.google.com/apppasswords and create an app password
# 3. Paste the 16-character password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="Chess App <youraddress@gmail.com>"
