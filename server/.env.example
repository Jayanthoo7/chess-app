PORT=3001

# Where your deployed frontend lives (used later for CORS/email links). For local dev this can stay as-is.
CLIENT_URL=http://localhost:5173

# Any long random string — used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) — get free keys at
# https://www.google.com/recaptcha/admin/create  (choose reCAPTCHA v2 > "I'm not a robot" Checkbox)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Brevo (free transactional email API) for sending OTP emails — SMTP from
# hosts like Render often times out talking to Gmail directly, so we send
# over Brevo's HTTPS API instead:
# 1. Sign up free at https://www.brevo.com (no credit card required)
# 2. Add + verify a sender email (Senders, Domains & Dedicated IPs > Senders)
#    — this can be your own Gmail address, just click the confirmation link
#    Brevo emails you. No custom domain needed.
# 3. Create an API key: SMTP & API > API Keys > Generate a new API key
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=youraddress@gmail.com
